APP_NAME=elplan
ENV=dev
DATABASE_URL=postgresql+psycopg://elplan:elplan@localhost:5432/elplan
CORS_ORIGINS=http://localhost:8080
SECRET_KEY=dev-insecure-change-me-0123456789abcdef
# OAuth2/OIDC (optional). Authentik example:
# OAUTH_CLIENT_ID=...
# OAUTH_CLIENT_SECRET=...
# OAUTH_DISCOVERY_URL=https://authentik.example.com/application/o/elplan/.well-known/openid-configuration
# OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/callback
# FRONTEND_URL=http://localhost:8080
# Blueprint/asset storage: filesystem (default) or s3 (AWS S3, MinIO, Ceph)
# STORAGE_BACKEND=filesystem
# STORAGE_LOCAL_ROOT=/data/uploads
# STORAGE_MAX_UPLOAD_BYTES=26214400
# STORAGE_BACKEND=s3
# S3_BUCKET=elplan
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ADDRESSING_STYLE=path
# S3_PRESIGN_DOWNLOADS=false
